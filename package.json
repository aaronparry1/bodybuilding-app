{
  "name": "hypertrophy-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/oswald": "^0.2.3",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~56.0.19",
    "expo-build-properties": "~56.0.25",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.24",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "56.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-purchases": "10.6.0",
    "react-native-purchases-ui": "10.6.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.14",
    "typescript": "~6.0.3",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:qa": "bash scripts/dev-web-qa.sh",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "scan:production-payload": "node scripts/scan-production-payload.mjs",
    "certify:generator": "vite-node --config vitest.config.ts scripts/generate-canonical-generator-certification.ts",
    "test:ios:release-candidate": "bash scripts/run-ios-release-candidate-ui-tests.sh",
    "eas:build:dev:ios": "npx eas-cli@latest build -p ios --profile development",
    "eas:build:dev:android": "npx eas-cli@latest build -p android --profile development",
    "eas:build:staging:ios": "npx eas-cli@latest build -p ios --profile preview",
    "eas:build:staging:android": "npx eas-cli@latest build -p android --profile preview",
    "eas:build:production:ios": "npx eas-cli@latest build -p ios --profile production",
    "eas:build:production:android": "npx eas-cli@latest build -p android --profile production",
    "supabase:staging:check": "node scripts/staging-supabase-check.mjs",
    "supabase:staging:schema": "node scripts/apply-supabase-schema.mjs",
    "supabase:staging:readiness": "node scripts/run-supabase-readiness-sql.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true
}
